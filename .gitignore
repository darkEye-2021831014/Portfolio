# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/
build/
dist/

# production
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# misc
.DS_Store
*.pem
.vscode/
.idea/

# env files (keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only artefacts (NOT for the repo) ----------------------------
# npm cache redirected to a local path when the user-writable system
# cache isn't available. Keep on disk, but never commit.
.npm-cache/

# Python venv at the repo root (created by the Lighthouse tooling
# that isn't part of the portfolio build).
.venv/

# Puku CLI scratch state — not user code, never commit.
.puku-cli/

# OS / editor swap files
*.swp
*.swo
*~
.dynamodb/
.localstack/

# Logs that some tools dump at the repo root
lighthouse-report.*
*.trace
*.trace.json

# CI / workflow — ignored by request. Removing this means GitHub
# Actions won't run on PRs. The repo works fine without it; CI just
# stops catching lint / typecheck / build regressions on the remote.
.github/workflows/

# Next.js scaffold leftover — `next.config.mjs` is the real config
# (loaded by Next 14). The `.js` file is an unused stub from the
# original `create-next-app` template and is safe to ignore.
next.config.js
