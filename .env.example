# Portfolio environment variables.
#
# Copy this file to `.env.local` and fill in any values you want to enable.
# The app runs with sensible defaults for every section below, so an empty
# `.env.local` is a valid configuration.
#
# All of the keys below are SERVER-ONLY. They are read inside route handlers
# or server components and are NEVER shipped to the browser bundle.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical site URL used for og:url and absolute links. Leave blank in dev.
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# Supabase (contact form storage) — OPTIONAL
# ---------------------------------------------------------------------------
# The contact form works without Supabase: submissions are accepted, the user
# sees a success message, and we return `stored: false` so the UI can surface
# a non-blocking note. Set both vars to persist messages durably.
#
#   1. Create a free project at https://supabase.com (free tier is enough).
#   2. Project Settings → API:
#        - SUPABASE_URL  = the "Project URL"
#        - SUPABASE_SERVICE_ROLE_KEY = the "service_role" secret
#   3. SQL Editor → New query → paste supabase/schema.sql → Run.
#
# SECURITY: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Never
# expose it to the client (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Resend (contact form email notification) — OPTIONAL
# ---------------------------------------------------------------------------
# When set, every successful contact submission is also forwarded to the
# address in RESEND_TO_EMAIL (or CONTACT.email from /content if unset).
# Resend free tier: 3,000 emails / month, 100 / day.
#
#   1. Create a free account at https://resend.com.
#   2. API Keys → Create API key → paste below.
#   3. RESEND_FROM_EMAIL must be a verified domain or `onboarding@resend.dev`
#      for the free tier (the latter is the default if you leave it blank).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=
